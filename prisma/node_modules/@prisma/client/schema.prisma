// Prisma Schema using recommended conventions:
// - Model names: Singular, PascalCase (e.g., User, Post)
// - Field names (columns): camelCase (e.g., createdAt, authorId)
// - Table names: Default Prisma mapping (PascalCase, matches Model name)
// - Pivot tables: Clear combinations (e.g., PermissionRole)
// - Added unique username field to User model.
// - Reordered fields in Comment model for visual preference.
// - Moved timestamp fields (createdAt, updatedAt) to the end of each model definition.

generator client {
  provider = "prisma-client-js"
  output   = "./node_modules/@prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // Pastikan variabel ini benar di .env
}

// --- Core Authentication and Authorization Models ---

model User {
  id       Int     @id @default(autoincrement())
  name     String?
  username String  @unique // Username unik ditambahkan
  email    String  @unique
  password String // Menyimpan hash password

  // Relations
  posts       Post[] // Relasi ke postingan pengguna
  comments    Comment[] // Relasi ke komentar pengguna
  roles       UserRole[] // Relasi ke peran pengguna via tabel pivot
  permissions UserPermission[] // Relasi ke izin langsung pengguna via tabel pivot

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id        Int    @id @default(autoincrement())
  name      String @unique // contoh: "admin", "author", "editor"
  guardName String @default("api") @map("guard_name") // Nama guard, map ke snake_case di DB jika diinginkan

  // Relations
  permissions PermissionRole[] // Relasi ke izin peran via tabel pivot
  users       UserRole[] // Relasi ke pengguna dengan peran ini via tabel pivot

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id        Int    @id @default(autoincrement())
  name      String @unique // contoh: "createPost", "publishPost", "manageUsers" (camelCase)
  guardName String @default("api") @map("guard_name") // Nama guard

  // Relations
  roles PermissionRole[] // Relasi ke peran dengan izin ini via tabel pivot
  users UserPermission[] // Relasi ke pengguna dengan izin ini via tabel pivot

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Pivot Tables for RBAC ---
// Note: Pivot tables often don't need explicit timestamps,
// but you could add them if tracking when relations were created/modified is important.

model PermissionRole {
  permissionId Int
  roleId       Int

  // Relations
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  // Map nama tabel pivot jika ingin snake_case di DB
  // @@map("permission_roles")

  // Composite primary key
  @@id([permissionId, roleId])
  // Optional index
  @@index([roleId])
}

model UserRole {
  userId Int
  roleId Int

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  // @@map("user_roles")

  // Composite primary key
  @@id([userId, roleId])
  // Optional index
  @@index([roleId])
}

model UserPermission {
  userId       Int
  permissionId Int

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  // @@map("user_permissions")

  // Composite primary key
  @@id([userId, permissionId])
  // Optional index
  @@index([permissionId])
}

// --- Core Blog Content Models ---

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  slug      String  @unique // Bagian URL yang SEO-friendly
  content   String  @db.Text // Tipe TEXT untuk konten panjang
  published Boolean @default(false) // Status draft/published
  imagePath String? // Path ke gambar lokal (camelCase)

  // Relations
  authorId Int // Foreign key (camelCase)
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade) // Jika user dihapus, hapus postnya

  categoryId Int? // Foreign key (camelCase), opsional
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull) // Jika kategori dihapus, set categoryId post jadi NULL

  comments Comment[] // Relasi ke komentar post
  tags     PostsTags[] // Relasi ke tag post via tabel pivot

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional index
  @@index([authorId])
  @@index([categoryId])
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  // Relations
  posts Post[] // Relasi ke postingan dalam kategori ini

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  // Relations
  posts PostsTags[] // Relasi ke postingan dengan tag ini via tabel pivot

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Pivot Table for Post <-> Tag (Many-to-Many) ---
// Note: Pivot tables often don't need explicit timestamps.

model PostsTags {
  postId Int // Foreign key (camelCase)
  tagId  Int // Foreign key (camelCase)

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  // @@map("posts_tags")

  // Composite primary key
  @@id([postId, tagId])
  // Optional index
  @@index([tagId])
}

// --- Comment Model ---

model Comment {
  id               Int    @id @default(autoincrement())
  content          String @db.Text
  moderationStatus String @default("pending") @map("moderation_status") // contoh: "pending", "approved", "rejected" (map ke snake_case jika perlu)

  // Relations
  postId Int // Foreign key (camelCase)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade) // Jika post dihapus, hapus komentarnya

  authorId Int // Foreign key (camelCase)
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade) // Jika user dihapus, hapus komentarnya

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional index
  @@index([postId])
  @@index([authorId])
}
